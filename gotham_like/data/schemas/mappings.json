{
  "description": "Declarative source-to-ontology mappings for the synthetic demonstration sources. Each mapping's hash is part of the transformation_version recorded in lineage.",
  "mappings": [
    {"record_type": "person_crm",
     "entities": [
       {"key": "p", "type": "Person", "key_template": "{person_id}",
        "properties": {"name": "full_name", "email": "email", "phone": "phone", "date_of_birth": "dob", "address": "address", "nationality": "nationality", "occupation": "occupation"}},
       {"key": "a", "type": "Address", "key_template": "{address}", "properties": {"line1": "address", "city": "city"}}],
     "relationships": [{"type": "REGISTERED_AT", "source": "p", "target": "a"}]},
    {"record_type": "person_kyc",
     "entities": [
       {"key": "p", "type": "Person", "key_template": "kyc:{kyc_id}",
        "properties": {"name": "name", "email": "email", "phone": "phone", "date_of_birth": "date_of_birth", "address": "address"}}]},
    {"record_type": "organization",
     "entities": [
       {"key": "o", "type": "Organization", "key_template": "{org_id}",
        "properties": {"name": "name", "registration_number": "registration_number", "jurisdiction": "jurisdiction", "industry": "industry", "address": "address"}}]},
    {"record_type": "employment",
     "entities": [
       {"key": "p", "type": "Person", "key_template": "{person_id}", "stub": true},
       {"key": "o", "type": "Organization", "key_template": "{org_id}", "stub": true}],
     "relationships": [{"type": "WORKS_FOR", "source": "p", "target": "o", "timestamp": "since", "start_time": "since", "properties": {"role_title": "role_title"}}]},
    {"record_type": "control",
     "entities": [
       {"key": "c", "type": "{controller_type}", "key_template": "{controller_id}", "stub": true},
       {"key": "o", "type": "Organization", "key_template": "{controlled_id}", "stub": true}],
     "relationships": [{"type": "CONTROLS", "source": "c", "target": "o", "timestamp": "since", "start_time": "since", "properties": {"share_pct": "share_pct"}}]},
    {"record_type": "account",
     "entities": [
       {"key": "acc", "type": "Account", "key_template": "{account_id}",
        "properties": {"account_number": "account_number", "account_type": "account_type", "currency": "currency", "opened_at": "opened_at", "status": "status"}},
       {"key": "own", "type": "{owner_type}", "key_template": "{owner_id}", "stub": true}],
     "relationships": [{"type": "OWNS", "source": "own", "target": "acc", "timestamp": "opened_at", "start_time": "opened_at"}],
     "events": [{"event_type": "account_opened", "timestamp": "opened_at", "entities": ["acc", "own"]}]},
    {"record_type": "device",
     "entities": [{"key": "d", "type": "Device", "key_template": "{device_id}", "properties": {"device_id": "device_id", "device_type": "device_type", "os": "os", "fingerprint": "fingerprint"}}]},
    {"record_type": "device_usage",
     "entities": [
       {"key": "acc", "type": "Account", "key_template": "{account_id}", "stub": true},
       {"key": "d", "type": "Device", "key_template": "{device_id}", "stub": true, "properties": {"device_id": "device_id"}}],
     "relationships": [{"type": "USED", "source": "acc", "target": "d", "timestamp": "first_seen", "start_time": "first_seen"}]},
    {"record_type": "transaction",
     "entities": [
       {"key": "t", "type": "Transaction", "key_template": "{txn_id}", "lat": "lat", "lon": "lon", "observed_at": "ts",
        "properties": {"transaction_id": "txn_id", "amount": "amount", "currency": "currency", "channel": "channel", "timestamp": "ts", "status": "status"}},
       {"key": "from", "type": "Account", "key_template": "{from_account}", "stub": true},
       {"key": "to", "type": "Account", "key_template": "{to_account}", "stub": true},
       {"key": "loc", "type": "Location", "key_template": "{location_id}", "stub": true},
       {"key": "ip", "type": "IPAddress", "key_template": "{ip}", "properties": {"ip": "ip"}}],
     "relationships": [
       {"type": "INITIATED", "source": "from", "target": "t", "timestamp": "ts", "properties": {"amount": "amount"}},
       {"type": "TRANSFERRED_TO", "source": "t", "target": "to", "timestamp": "ts", "properties": {"amount": "amount"}},
       {"type": "LOCATED_AT", "source": "t", "target": "loc", "timestamp": "ts"},
       {"type": "CONNECTED_TO", "source": "from", "target": "ip", "timestamp": "ts", "properties": {"via": {"const": "transaction"}}}],
     "events": [{"event_type": "transaction", "timestamp": "ts", "entities": ["from", "to", "t", "ip"], "location": "loc", "lat": "lat", "lon": "lon",
                 "properties": {"amount": "amount", "currency": "currency", "channel": "channel", "transaction_id": "txn_id"}}]},
    {"record_type": "location",
     "entities": [{"key": "l", "type": "Location", "key_template": "{location_id}", "lat": "lat", "lon": "lon",
                   "properties": {"name": "name", "city": "city", "country": "country", "lat": "lat", "lon": "lon", "category": "category"}}]},
    {"record_type": "activity_event",
     "entities": [
       {"key": "acc", "type": "Account", "key_template": "{account_id}", "stub": true},
       {"key": "d", "type": "Device", "key_template": "{device_id}", "stub": true, "properties": {"device_id": "device_id"}},
       {"key": "ip", "type": "IPAddress", "key_template": "{ip}", "properties": {"ip": "ip"}},
       {"key": "loc", "type": "Location", "key_template": "{location_id}", "stub": true},
       {"key": "dom", "type": "Domain", "key_template": "{domain}", "stub": true, "properties": {"domain": "domain"}}],
     "relationships": [
       {"type": "USED", "source": "acc", "target": "d", "timestamp": "ts", "properties": {"via": "event_type"}},
       {"type": "CONNECTED_TO", "source": "d", "target": "ip", "timestamp": "ts", "properties": {"via": "event_type"}},
       {"type": "CONNECTED_TO", "source": "d", "target": "dom", "timestamp": "ts", "properties": {"via": "event_type"}},
       {"type": "VISITED", "source": "d", "target": "loc", "timestamp": "ts"}],
     "events": [{"event_type": {"field": "event_type"}, "timestamp": "ts", "entities": ["acc", "d", "ip", "dom"], "location": "loc", "lat": "lat", "lon": "lon",
                 "properties": {"detail": "detail", "ip": "ip"}}]},
    {"record_type": "domain",
     "entities": [
       {"key": "dom", "type": "Domain", "key_template": "{domain}", "properties": {"domain": "domain", "registrar": "registrar", "created": "created"}},
       {"key": "ip", "type": "IPAddress", "key_template": "{resolves_to}", "properties": {"ip": "resolves_to"}}],
     "relationships": [{"type": "RESOLVES_TO", "source": "dom", "target": "ip", "timestamp": "created"}]},
    {"record_type": "vessel",
     "entities": [{"key": "v", "type": "Vessel", "key_template": "{vessel_id}", "properties": {"name": "name", "imo": "imo", "flag": "flag"}}]},
    {"record_type": "shipment",
     "entities": [
       {"key": "s", "type": "Shipment", "key_template": "{shipment_id}", "observed_at": "departed_at",
        "properties": {"shipment_id": "shipment_id", "product": "product", "quantity": "quantity", "status": "status", "origin": "origin_port", "destination": "destination_port"}},
       {"key": "sup", "type": "Organization", "key_template": "{supplier_id}", "stub": true},
       {"key": "cus", "type": "Organization", "key_template": "{customer_id}", "stub": true},
       {"key": "wh", "type": "Organization", "key_template": "{warehouse_org}", "stub": true},
       {"key": "v", "type": "Vessel", "key_template": "{vessel_id}", "stub": true},
       {"key": "op", "type": "Location", "key_template": "{origin_port}", "stub": true},
       {"key": "dp", "type": "Location", "key_template": "{destination_port}", "stub": true}],
     "relationships": [
       {"type": "SHIPPED_BY", "source": "s", "target": "sup", "timestamp": "departed_at"},
       {"type": "PASSED_THROUGH", "source": "s", "target": "op", "timestamp": "departed_at", "properties": {"leg": {"const": "origin"}}},
       {"type": "CARRIED_BY", "source": "s", "target": "v", "timestamp": "departed_at", "start_time": "departed_at", "end_time": "arrived_at"},
       {"type": "PASSED_THROUGH", "source": "v", "target": "dp", "timestamp": "arrived_at"},
       {"type": "PASSED_THROUGH", "source": "s", "target": "dp", "timestamp": "arrived_at", "properties": {"leg": {"const": "destination"}}},
       {"type": "SHIPPED_TO", "source": "s", "target": "wh", "timestamp": "arrived_at", "properties": {"stage": {"const": "warehouse"}}},
       {"type": "SHIPPED_TO", "source": "s", "target": "cus", "timestamp": "arrived_at", "properties": {"stage": {"const": "customer"}}}],
     "events": [
       {"event_type": "shipment_departure", "timestamp": "departed_at", "entities": ["s", "v", "sup"], "location": "op", "lat": "origin_lat", "lon": "origin_lon", "properties": {"product": "product"}},
       {"event_type": "shipment_arrival", "timestamp": "arrived_at", "entities": ["s", "v", "cus"], "location": "dp", "lat": "dest_lat", "lon": "dest_lon", "properties": {"product": "product"}}]}
  ]
}
